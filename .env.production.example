# Copy to a protected, untracked .env.production file. Use independent credentials per role.
APP_DOMAIN=maintenance.example.com
IMAGE_PREFIX=ghcr.io/perikliev00
RELEASE_SHA=replace-with-immutable-git-sha
POSTGRES_DB=maintenance
POSTGRES_ADMIN_USER=maintenance_admin
POSTGRES_ADMIN_PASSWORD=replace-with-secret-manager-value
MIGRATION_DATABASE_URL=postgresql://migration_user:replace@db:5432/maintenance?schema=public&connection_limit=3&connect_timeout=5
RUNTIME_DATABASE_URL=postgresql://runtime_user:replace@db:5432/maintenance?schema=public&connection_limit=10&connect_timeout=5
BOOTSTRAP_DATABASE_URL=postgresql://bootstrap_user:replace@db:5432/maintenance?schema=public&connection_limit=3&connect_timeout=5
METRICS_DATABASE_URL=postgresql://metrics_user:replace@db:5432/maintenance?sslmode=disable
JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
WEB_ORIGIN=https://maintenance.example.com
TRUST_PROXY=1
COOKIE_SECURE=1
E2E_DISABLE_RATE_LIMIT=0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-secret-manager-value
# REQUIRED before enabling Compose profile `monitoring` in staging/production.
# Compose falls back to a non-routable http://127.0.0.1:9/not-configured if unset —
# that is intentionally fail-visible but SILENT. Do not go live with monitoring
# until this is a real authenticated webhook (PagerDuty/Slack/Opsgenie/etc.).
ALERT_WEBHOOK_URL=https://alerts.example.com/maintenance
# Also configure an EXTERNAL uptime / dead-man check (not only in-Compose Prometheus):
# - HTTPS probe of https://$APP_DOMAIN/api/health/ready
# - Optional BACKUP_HEARTBEAT_URL from scripts/backup-db.sh (host-down detection)
# See docs/operations/incident-response.md § Monitoring go-live.
# Configure INITIAL_OWNER_* only for the one-time profiled create-owner command.
