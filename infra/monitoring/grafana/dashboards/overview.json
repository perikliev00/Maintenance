{
  "title": "Maintenance overview",
  "uid": "maintenance-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id":1,"type":"timeseries","title":"API requests / second","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum by (status) (rate(http_requests_total[5m]))","legendFormat":"{{status}}"}]},
    {"id":2,"type":"timeseries","title":"API 5xx ratio","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.01)","legendFormat":"5xx ratio"}]},
    {"id":3,"type":"timeseries","title":"Background job runs and failures","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"background_job_runs_total","legendFormat":"runs"},{"expr":"background_job_failures_total","legendFormat":"failures"}]},
    {"id":4,"type":"timeseries","title":"SSE connections","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"sse_connections_active","legendFormat":"active"}]},
    {"id":5,"type":"timeseries","title":"PostgreSQL connections","gridPos":{"h":8,"w":12,"x":0,"y":16},"targets":[{"expr":"pg_stat_activity_count","legendFormat":"connections"}]},
    {"id":6,"type":"timeseries","title":"Backup age (hours)","gridPos":{"h":8,"w":12,"x":12,"y":16},"targets":[{"expr":"(time() - backup_last_success_timestamp_seconds) / 3600","legendFormat":"hours"}]}
  ],
  "annotations":{"list":[]},
  "time":{"from":"now-24h","to":"now"},
  "timezone":"browser"
}
