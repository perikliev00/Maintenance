[Unit]
Description=Encrypted off-host Meridian Maintenance PostgreSQL backup
Documentation=file:/opt/maintenance/docs/operations/backup-install.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/maintenance
# Required keys in EnvironmentFile (production):
#   DATABASE_URL (host `db` on Compose backend network), BACKUP_S3_URI, BACKUP_AGE_RECIPIENT
# Optional: BACKUP_METRICS_FILE, BACKUP_HEARTBEAT_URL, BACKUP_ROLE_ARN
# Prefer backup-via-docker-network.sh so pg_dump reaches internal Postgres.
EnvironmentFile=/etc/maintenance/backup.env
Environment=BACKUP_METRICS_FILE=/opt/maintenance/infra/monitoring/textfile/backup.prom
Environment=DEPLOY_PATH=/opt/maintenance
UMask=0077
ExecStart=/opt/maintenance/scripts/aws/backup-via-docker-network.sh
NoNewPrivileges=true
PrivateTmp=true
# Docker socket access is required to attach to the Compose backend network.
# ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maintenance/infra/monitoring/textfile /tmp
SupplementaryGroups=docker
