{
  "name": "maintenance-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "oxlint --quiet src",
    "test": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:all": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "coverage": "c8 node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"src/**/*.test.ts\"",
    "coverage:all": "c8 node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:mutation": "stryker run stryker.config.mjs",
    "test:mutation:incremental": "stryker run --incremental stryker.config.mjs",
    "test:mutation:full": "stryker run stryker.full.config.mjs",
    "test:db": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 src/services/attendance/rebuild.test.ts src/services/cards.filter.test.ts src/services/roleGrants/seed.test.ts src/services/audit.write.test.ts",
    "test:cleaning-lifecycle": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/cleaning/**/*.test.ts\"",
    "test:readiness": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/readiness/**/*.test.ts\"",
    "test:tickets-lifecycle": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/tickets/**/*.test.ts\"",
    "test:plan": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/plan/**/*.test.ts\"",
    "test:sectors": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/sectors/**/*.test.ts\"",
    "test:shifts": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/shifts/**/*.test.ts\"",
    "test:my-work": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/my-work/**/*.test.ts\"",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap": "node dist/bootstrap.js",
    "db:create-owner": "node dist/createOwner.js",
    "db:setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "test:attendance": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/attendance/**/*.test.ts\"",
    "test:cards": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/cards/**/*.test.ts\"",
    "test:attendance:isolated": "npm run test:attendance --",
    "test:cards:isolated": "npm run test:cards --",
    "test:scenarios": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/scenarios/*.test.ts\"",
    "test:people": "node ./tests/runWithP1Isolation.mjs --test-concurrency=1 \"tests/people/**/*.test.ts\"",
    "test:inventory": "node ./scripts/assert-test-inventory.mjs",
    "test:regress-p1-isolated": "npm test --",
    "measure:analytics": "node --expose-gc --import tsx ./scripts/measure-housekeeping-summary.ts",
    "prove:p1-isolation": "node ./tests/proveP1Isolation.mjs",
    "smoke:attendance:isolated": "node --import ./tests/registerP1TestEnv.mjs --import tsx ./scripts/smoke-attendance-atomic.ts"
  },
  "dependencies": {
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "c8": "12.0.0",
    "oxlint": "^1.89.0",
    "prisma": "~6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "body-parser": "1.20.9",
    "ip-address": "10.7.4",
    "qs": "6.16.1",
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
