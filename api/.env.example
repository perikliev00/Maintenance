DATABASE_URL="postgresql://maintenance:maintenance@localhost:5433/maintenance?schema=public"
# Local-only placeholder (denylisted). Production refuses this value.
# Generate a real secret: openssl rand -base64 48
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET="local-dev-only-insecure-secret-do-not-use-in-prod"
PORT=4000
# Comma-separated browser origins allowed by CORS (no trailing slash).
WEB_ORIGIN="http://localhost:5173"
# Set to 1 when behind a reverse proxy so rate limits use the real client IP.
TRUST_PROXY=0
# Set to 1 to force Secure cookies outside NODE_ENV=production (e.g. HTTPS staging).
COOKIE_SECURE=0
