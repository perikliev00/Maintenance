{$APP_DOMAIN:localhost} {
	encode zstd gzip

	# SEC-005 / B1: SPA security headers (keep CSP compatible with Vite PWA).
	# Limitations: style-src allows 'unsafe-inline' for any inline style attributes
	# the SPA may emit; connect-src is same-origin only (/api proxy + EventSource).
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'"
		-Server
	}

	# SEC-001 / P0-T02: do not expose Prometheus metrics on the public edge.
	# Scrape internally on the backend network: api:4000/metrics
	# (see infra/monitoring/prometheus.yml).
	@apiMetrics path_regexp apiMetrics (?i)^/api/metrics(/|$)
	handle @apiMetrics {
		respond 404
	}

	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	@entry path / /index.html /sw.js /workbox-*.js /manifest.webmanifest
	header @entry Cache-Control "no-cache, no-store, must-revalidate"
	@fingerprinted path_regexp fingerprinted ^/assets/.+[-.][A-Za-z0-9_-]{8,}\.
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	root * /srv
	handle {
		try_files {path} /index.html
		file_server
	}
}

# Loopback-only liveness: independent of the public hostname and HTTPS redirects.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /health "ok" 200
	respond 404
}
