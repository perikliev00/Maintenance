{
  "name": "maintenance-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --quiet src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "coverage": "c8 tsx --test \"src/**/*.test.ts\"",
    "test:mutation": "stryker run stryker.config.mjs",
    "test:mutation:incremental": "stryker run --incremental stryker.config.mjs",
    "test:mutation:full": "stryker run stryker.full.config.mjs",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "c8": "12.0.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "qs": "6.16.1",
    "serialize-javascript": "7.1.3"
  }
}
